# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Gemini AI
GEMINI_API_KEY=AIza...

# WhatsApp (for later when approved)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
