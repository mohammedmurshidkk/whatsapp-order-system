# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# AI Provider Configuration
# Set the AI_PROVIDER to one of: "GEMINI", "OPENROUTER", "GROQ"
AI_PROVIDER=GEMINI

# API Keys for different providers
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=your_openrouter_api_key
GROQ_API_KEY=your_groq_api_key

# Model names for each provider
GEMINI_MODEL_NAME="gemini-1.5-flash"
OPENROUTER_MODEL_NAME="anthropic/claude-3-haiku"
GROQ_MODEL_NAME="llama3-8b-8192"

# WhatsApp (for later when approved)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token_for_webhook
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# Business notification (for MVP)
BUSINESS_NOTIFICATION_METHOD=console