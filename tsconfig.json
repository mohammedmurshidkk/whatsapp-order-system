{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@/services/*": [
        "services/*"
      ],
      "@/types": [
        "types/index"
      ],
      "@/utils/*": [
        "utils/*"
      ],
      "@/plugins/*": [
        "plugins/*"
      ],
      "@/controllers/*": [
        "controllers/*"
      ],
      "@/routes/*": [
        "routes/*"
      ],
      "@/middleware/*": [
        "middleware/*"
      ],
      "@/config/*": [
        "config/*"
      ],
      "@/i18n/*": [
        "i18n/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}