{
  "name": "whatsapp-order-system",
  "version": "1.0.0",
  "description": "AI-powered WhatsApp ordering system",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --ignore whatsapp-session/ --ignore .wwebjs_cache/ --exec ts-node -r tsconfig-paths/register src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:scenarios": "jest --testPathPattern=orderFlow",
    "test:integration": "ts-node -r tsconfig-paths/register tests/integration/testRunner.ts",
    "test:generate-scenarios": "ts-node -r tsconfig-paths/register tests/integration/generateFromMessages.ts",
    "test:parse-chats": "ts-node -r tsconfig-paths/register tests/utils/chatParser.ts tests/chats",
    "test:add-scenario": "ts-node -r tsconfig-paths/register tests/utils/addScenario.ts",
    "test:list-scenarios": "ts-node -r tsconfig-paths/register tests/utils/addScenario.ts list",
    "migrate:fresh": "ts-node -r tsconfig-paths/register scripts/migrate.ts fresh",
    "migrate:update": "ts-node -r tsconfig-paths/register scripts/migrate.ts update",
    "migrate:business": "ts-node -r tsconfig-paths/register scripts/migrate.ts business"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@openrouter/sdk": "^0.2.9",
    "@supabase/supabase-js": "^2.39.0",
    "@types/form-data": "^2.5.2",
    "@types/multer": "^2.0.0",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "escpos": "3.0.0-alpha.6",
    "escpos-network": "3.0.0-alpha.5",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "groq-sdk": "^0.37.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "openai": "^6.10.0",
    "pg": "^8.11.3",
    "puppeteer": "^24.34.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.34.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "qrcode-terminal": "^0.12.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}