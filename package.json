{
  "name": "whatsapp-order-system",
  "version": "1.0.0",
  "description": "AI-powered WhatsApp ordering system",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:scenarios": "jest --testPathPattern=orderFlow",
    "test:parse-chats": "ts-node tests/utils/chatParser.ts tests/chats",
    "test:add-scenario": "ts-node tests/utils/addScenario.ts",
    "test:list-scenarios": "ts-node tests/utils/addScenario.ts list",
    "migrate:fresh": "ts-node scripts/migrate.ts fresh",
    "migrate:update": "ts-node scripts/migrate.ts update",
    "migrate:business": "ts-node scripts/migrate.ts business"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@openrouter/sdk": "^0.2.9",
    "@supabase/supabase-js": "^2.39.0",
    "@types/multer": "^2.0.0",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "groq-sdk": "^0.37.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "openai": "^6.10.0",
    "pg": "^8.11.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
